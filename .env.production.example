# NN-LRMS Production Environment
# Copy this to .env and fill in the values:
#   cp .env.production.example .env

# ─── PostgreSQL ───
POSTGRES_HOST=postgres
POSTGRES_DB=db_nnlrms
POSTGRES_USER=nnlrms
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_PORT=5432

# ─── Redis ───
# docker-compose provides redis://redis:6379 by default.
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=nn-lrms

# ─── Application ───
APP_PORT=3000
NEXTAUTH_URL=<public origin of this deploy, e.g. https://nn-lrms.example.go.th>
NEXTAUTH_SECRET=<generate-with: openssl rand -base64 32>
ENCRYPTION_KEY=<generate-with: openssl rand -hex 32>

# audit_logs retention window in days (batched purge, ~5s after startup then
# daily). Default 30 if unset/invalid. Set to "off" to disable purging.
# AUDIT_LOG_RETENTION_DAYS=30

# ─── BMS Session API ───
BMS_VALIDATE_URL=https://hosxp.net/phapi/PasteJSON
DEV_HOSPITAL_TUNNEL_URL=
DEV_AUTH_BYPASS=false

# REQUIRED for admin access in production: comma-separated Thai CIDs of authorized administrators.
# Grant + cap: listed CIDs are promoted to ADMIN on BMS (readwrite) login regardless of
# HOSxP position; unlisted users never reach /admin even with a "director" position.
ADMIN_ALLOWED_CIDS=

# ─── ProviderID OAuth2 (readonly login) ───
NEXT_PUBLIC_MOPH_OAUTH_CLIENT_ID=<moph-oauth-client-id>
MOPH_OAUTH_CLIENT_SECRET=<moph-oauth-client-secret>
PROVIDER_API_CLIENT_ID=<provider-api-client-id>
PROVIDER_API_SECRET_KEY=<provider-api-secret-key>
NEXT_PUBLIC_MOPH_OAUTH_URL=https://moph.id.th
NEXT_PUBLIC_PROVIDER_API_URL=https://provider.id.th

# ─── MOPH Prompt (LINE) risk alerts ───
# MOPH_ALERTS_ENABLED=false disables the whole pipeline (enqueue + drain).
MOPH_ALERTS_ENABLED=true
# Transport: "bms" = BMS-session sender (per-hospital tunnel), "v3.1" =
# MOPH Alert Free Form API (docs/API Alert Free Form JSON 3.1.pdf,
# POST {MOPH_ALERT_API_URL}/alert/v3.1/messages with client-key/secret-key).
MOPH_TRANSPORT=bms
MOPH_PROMPT_API_URL=https://sms.bmscloud.in.th/v1/moph/send-via-bms-session
MOPH_ALERT_API_URL=https://morpromt2c.moph.go.th
MOPH_ALERT_CLIENT_KEY=<moph-alert-client-key>
MOPH_ALERT_SECRET_KEY=<moph-alert-secret-key>
MOPH_ALERT_MESSAGE_TYPE=HPT
MOPH_MAX_ALERTS_PER_DRAIN=5
MOPH_PER_SEND_TIMEOUT_MS=3000
MOPH_DRAIN_BUDGET_MS=10000
MOPH_MAX_502_RETRIES=4
MOPH_RETRY_BACKOFF_MS=500
MOPH_ALERT_RETENTION_DAYS=90
