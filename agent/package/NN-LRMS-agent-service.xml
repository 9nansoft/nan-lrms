<?xml version="1.0" encoding="utf-8"?>
<!--
  WinSW service definition for the NN-LRMS agent.

  WinSW (Windows Service Wrapper) runs the agent as a Windows service: it
  starts with the machine, restarts when it crashes, and writes its own log.
  The agent itself is nn-lrms-agent.exe — a single self-contained file (the
  runtime is embedded), so the workstation needs nothing else installed.

  The XML must sit next to the wrapper EXE and carry the same base name
  (NN-LRMS-agent-service.exe + NN-LRMS-agent-service.xml).

  Install (as Administrator):
    NN-LRMS-agent-service.exe install
    NN-LRMS-agent-service.exe start
-->
<service>
  <id>NN-LRMS-agent</id>
  <name>NN-LRMS Agent</name>
  <description>ดึงข้อมูลห้องคลอดจาก HOSxP ของโรงพยาบาลและส่งเข้าเซิร์ฟเวอร์ NN-LRMS</description>

  <executable>%BASE%\nn-lrms-agent.exe</executable>
  <arguments></arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>

  <!-- Crash recovery: two quick restarts, then leave it for the hospital's
       IT to look at (the log says why). -->
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <onfailure action="none"/>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <!-- LocalService: no interactive logon, least privilege. WinSW v2 requires
       separate <domain> and <user> elements (not the v3-only username tag)
       and allowservicelogon=true so SeServiceLogonRight is granted. -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>

  <!-- Where the agent keeps its config. The agent also finds it next to its
       own file, so this is only an explicit hint. -->
  <env name="AGENT_CONFIG" value="%BASE%\agent.config.json"/>
</service>
