<?xml version="1.0" encoding="utf-8"?>
<!--
  WinSW service definition for the NN-LRMS agent.

  WinSW (Windows Service Wrapper) runs the agent as a Windows service:
  it starts with the machine, restarts when it crashes, and writes its own
  log. The agent itself is agent.exe — a single self-contained file (Node
  runtime included), so the workstation needs nothing else installed.

  Install (as Administrator, in the folder that holds the three files):
    copy agent.exe          NN-LRMS-agent.exe
    copy NN-LRMS-agent.xml  (this file)  NN-LRMS-agent.xml
    (keep agent.config.json in the same folder)
    NN-LRMS-agent.exe install
    NN-LRMS-agent.exe start

  The service account must be able to READ agent.config.json (it holds the
  hospital's API key) and reach the local HOSxP gateway on 127.0.0.1:45011.
-->
<service>
  <id>NN-LRMS-agent</id>
  <name>NN-LRMS Agent</name>
  <description>ดึงข้อมูลห้องคลอดจาก HOSxP ของโรงพยาบาลและส่งเข้าเซิร์ฟเวอร์ NN-LRMS</description>

  <executable>%BASE%\agent.exe</executable>
  <arguments></arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>

  <!-- Crash recovery: two quick restarts, then give up and leave it for the
       IT of the hospital to look at (the log says why). -->
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <onfailure action="none"/>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <!-- LocalService: no interactive logon, least privilege. Give the service
       account read access to agent.config.json. -->
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
    <allowservicelogon>false</allowservicelogon>
  </serviceaccount>

  <!-- The agent's own stdout/stderr goes to the WinSW log; keep the
       console quiet when started by hand. -->
  <env name="AGENT_CONFIG" value="%BASE%\agent.config.json"/>
</service>
